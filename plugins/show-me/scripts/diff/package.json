{
  "name": "@show-me/diff",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "vp run -F @show-me/diff-cli... build",
    "dev": "pnpm -F @show-me/diff-client dev",
    "test": "vitest run",
    "typecheck": "tsc -p packages/shared --noEmit && tsc -p packages/server --noEmit && tsc -p packages/client --noEmit && tsc -p packages/cli --noEmit",
    "clean": "pnpm -r --parallel exec rm -rf dist node_modules/.vite"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "@voidzero-dev/vite-plus-core": "^0.1.24",
    "happy-dom": "^20.10.2",
    "typescript": "^5.6.0",
    "vite-plus": "^0.1.24",
    "vitest": "^4.0.0"
  }
}
